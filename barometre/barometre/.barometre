conky.config = {
-- — Conky settings

	background = true,  
	use_xft = true,
	font = 'Dyuthi:size=10',
	xftalpha = 1,
	update_interval = 5,
	total_run_times = 0,
	own_window = true,
	own_window_transparent = true,  
        own_window_argb_visual = true,

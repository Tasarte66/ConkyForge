	double_buffer = true,
	minimum_width = 188, minimum_height = 223,
        maximum_width = 188,
	text_buffer_size = 2048,
	draw_shades = false,
	draw_outline = true,
	draw_borders = false,
	draw_graph_borders = false,
	default_color = 'white',
